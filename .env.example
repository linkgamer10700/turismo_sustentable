# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS (MYSQL)
# ==========================================
# Para uso con Docker Compose (nombre de host del servicio: 'db'):
DATABASE_URL="mysql://turismo_user:turismo_pass@db:3306/turismo_sustentable"

# Para desarrollo local fuera de Docker (conectando a MySQL local o al puerto expuesto 3306 de Docker):
# DATABASE_URL="mysql://turismo_user:turismo_pass@localhost:3306/turismo_sustentable"

# ==========================================
# CONFIGURACIÓN DE AUTENTICACIÓN (NEXTAUTH / AUTH.JS)
# ==========================================
# Clave secreta para cifrado de tokens JWT (puedes generar una con `openssl rand -base64 32`)
AUTH_SECRET="tu_secreto_super_seguro_cambialo_en_produccion_123456789"
AUTH_TRUST_HOST="true"

# URL base de la aplicación
NEXTAUTH_URL="http://localhost:3000"
